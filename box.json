{
  "datetime": "release_date",
  "finder": [
    {
      "name": "*.php",
      "in": [
        "src"
      ]
    },
    {
      "notName": "/.*\\.md|.*\\.dist|Makefile|composer\\.json|composer\\.lock|LICENSE|CHANGELOG|README\\.*|Howto\\.rst/",
      "exclude": [
        "bin",
        "example",
        "examples",
        "test",
        "test_old",
        "tests",
        "Tests",
        "Tester"
      ],
      "in": [
        "vendor"
      ]
    }
  ],
  "finder-bin": [
    {
      "in": [
        "resources"
      ]
    }
  ],
  "compression": "GZ",
  "compactors": [
    "KevinGH\\Box\\Compactor\\Php",
    "KevinGH\\Box\\Compactor\\Json"
  ],
  "git-commit-short": "package_version",
  "git-version": "package_branch_alias_version",
  "output": "typo3scan.phar"
}
