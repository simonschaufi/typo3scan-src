* text=auto

# Set syntax highlight on GitHub
# https://github.com/github-linguist/linguist/blob/main/lib/linguist/languages.yml
*.neon linguist-language=YAML

# Enforce checkout with linux lf consistent over all platforms
*.php text eol=lf
*.rst text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xlf text eol=lf
*.sh text eol=lf
*.txt text eol=lf

/.* export-ignore
/examples export-ignore
/stubs export-ignore
/tests export-ignore
/AGENTS.md export-ignore
/box.json export-ignore
/composer.lock export-ignore
/ecs.php export-ignore
/phpstan.neon export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.xml.dist export-ignore
/rector.php export-ignore
/syncChangelog.sh export-ignore
/typo3scan export-ignore
/typo3scan.phar export-ignore
/updateLinks.sh export-ignore
